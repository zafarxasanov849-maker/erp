# Nusxa oling: cp .env.example .env.local  — va qiymatlarni to'ldiring.
# `supabase start` chiqargan qiymatlar (yoki supabase.com → Project Settings → API).

# Brauzerga ham chiqadi — faqat URL va anon (publishable) kalit.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FAQAT serverda: cron/webhook'lar (src/app/api/**) va xodim yaratish (src/features/staff/actions.ts).
# Hech qachon NEXT_PUBLIC_ bilan boshlamang.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth "Send SMS" hook sirini (v1,whsec_...) shu yerga yozing.
# Lokal: supabase/config.toml → [auth.hook.send_sms] secrets qiymati bilan bir xil.
# Production: Supabase Dashboard → Authentication → Hooks → Send SMS (URI: https://<domen>/api/auth/sms-hook).
SEND_SMS_HOOK_SECRET=

# Faqat lokal/e2e: production build'da SMS kodlarini /api/dev/sms orqali ko'rsatish.
# Production'da HECH QACHON yoqmang.
# DEV_SMS_INBOX=1

# Vercel Cron so'rovlarini tekshirish uchun (5-bosqich)
CRON_SECRET=

# Eskiz.uz SMS (9-bosqich)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Telegram bot (9-bosqich)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
